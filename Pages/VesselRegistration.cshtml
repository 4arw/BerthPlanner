@page
@model VesselRegistrationModel
@using BerthPlanner.Model

@{
    ViewData["Title"] = "Vessel Registration";
}

@section PageHeader {
    <h2>Vessel Registration</h2>
    <p>Register new vessels and update existing vessel information.</p>
}


<div class="container mt-4">

    <h2 class="mb-2" style="color:#0B3D6E">
        Vessel Registration
    </h2>

    <p class="text-muted mb-4">
        Register new vessels and update existing vessel information.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success auto-hide">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <!-- Add Vessel -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 style="color:#0B3D6E">
                Register New Vessel
            </h4>

            <form method="post" asp-page-handler="Add">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label">IMO Number</label>
                        <input asp-for="IMONumber"
                               class="form-control"
                               maxlength="7"
                               placeholder="7-digit IMO Number"
                               required />
                        <span id="imoHint" class="form-text d-block">0/7 digits</span>
                        <span asp-validation-for="IMONumber"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Vessel Name</label>
                        <input asp-for="VesselName"
                               class="form-control"
                               maxlength="50"
                               required />
                        <span asp-validation-for="VesselName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Length (m)</label>
                        <input asp-for="Length"
                                type="number"
                                step="0.01"
                                class="form-control"
                                required />
                        <span asp-validation-for="Length"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Draft (m)</label>
                        <input asp-for="Draft"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control"
                               required />
                        <span asp-validation-for="Draft"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Cargo Type</label>
                        <select asp-for="CargoType"
                                asp-items="Html.GetEnumSelectList<CargoType>()"
                                class="form-select">
                        </select>
                            <div id="cargoPriorityNote" class="alert alert-warning mt-2 py-2" style="display:none">
                                Medical and Food cargo receive high priority handling.
                            </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Agent Name</label>
                        <input asp-for="AgentName"
                               class="form-control"
                               maxlength="100"
                               required />
                        <span asp-validation-for="AgentName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Agent Email</label>
                        <input asp-for="AgentEmail"
                               type="email"
                               class="form-control"
                               required />
                        <span asp-validation-for="AgentEmail"
                              class="text-danger"></span>
                    </div>

                </div>

                <button type="submit"
                        class="btn btn-primary mt-4">
                    Register Vessel
                </button>

            </form>

        </div>
    </div>

    <!-- Registered Vessels -->
    <div class="card shadow-sm">
        <div class="card-body">

            <h4 class="mb-3" style="color:#0B3D6E">
                Registered Vessels
            </h4>
            <input id="vesselSearch" class="form-control mb-3"
                 placeholder="Search by name, IMO, cargo or agent..." />
            <div class="table-responsive">

                <table  id="vesselsTable" class="table table-bordered table-striped align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>IMO</th>
                            <th>Name</th>
                            <th>Length</th>
                            <th>Draft</th>
                            <th>Cargo</th>
                            <th>Agent</th>
                            <th>Email</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var vessel in Model.Vessels)
                        {
                            <tr class="vessel-row">
                                <td>@vessel.VesselId</td>
                                <td>@vessel.IMONumber</td>
                                <td>@vessel.VesselName</td>
                                <td>@vessel.Length m</td>
                                <td>@vessel.Draft m</td>
                                <td>@vessel.CargoType</td>
                                <td>@vessel.AgentName</td>
                                <td>@vessel.AgentEmail</td>

                                <td>
                                    <button type="button"
                                            class="btn btn-warning btn-sm"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#edit-@vessel.VesselId">
                                        Edit
                                    </button>
                                </td>
                            </tr>

                            <tr class="collapse"
                                id="edit-@vessel.VesselId">

                                <td colspan="9">

                                    <form method="post"
                                          asp-page-handler="Edit"
                                          class="p-3 bg-light rounded">

                                        <input type="hidden"
                                               name="vesselId"
                                               value="@vessel.VesselId" />

                                        <h5>Edit Vessel: @vessel.VesselName</h5>

                                        <div class="row g-3">

                                            <div class="col-md-4">
                                                <label class="form-label">IMO Number</label>
                                                <input name="imoNumber"
                                                       value="@vessel.IMONumber"
                                                       maxlength="7"
                                                       class="form-control"
                                                       required />
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label">Vessel Name</label>
                                                <input name="vesselName"
                                                       value="@vessel.VesselName"
                                                       maxlength="50"
                                                       class="form-control"
                                                       required />
                                            </div>

                                            <div class="col-md-4">
                                                <label class="form-label">Cargo Type</label>
                                                <select name="cargoType"
                                                        class="form-select">

                                                    @foreach (var cargo in Enum.GetValues<CargoType>())
                                                    {
                                                        if (cargo == vessel.CargoType)
                                                        {
                                                            <option value="@cargo" selected>
                                                                @cargo
                                                            </option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@cargo">
                                                                @cargo
                                                            </option>
                                                        }
                                                    }

                                                </select>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="form-label">Length</label>
                                                <input name="length"
                                                       type="number"
                                                       step="0.01"
                                                       min="0.01"
                                                       value="@vessel.Length.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                       class="form-control"
                                                       required />
                                            </div>

                                            <div class="col-md-3">
                                                <label class="form-label">Draft</label>
                                                <input asp-for="Draft"
                                                        type="number"
                                                        step="0.01"
                                                        class="form-control"
                                                        required />
                                            </div>

                                            <div class="col-md-3">
                                                <label class="form-label">Agent Name</label>
                                                <input name="agentName"
                                                       value="@vessel.AgentName"
                                                       class="form-control"
                                                       required />
                                            </div>

                                            <div class="col-md-3">
                                                <label class="form-label">Agent Email</label>
                                                <input name="agentEmail"
                                                       type="email"
                                                       value="@vessel.AgentEmail"
                                                       class="form-control"
                                                       required />
                                            </div>

                                        </div>

                                        <button type="submit"
                                                class="btn btn-success mt-3">
                                            Save Changes
                                        </button>

                                    </form>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.Vessels.Any())
            {
                <div class="alert alert-info">
                    No registered vessels found.
                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
