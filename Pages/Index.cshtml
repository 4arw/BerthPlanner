@page
@model IndexModel
@using BerthPlanner.Model

@{
    ViewData["Title"] = "Home Dashboard";
}

<div class="mt-4">

    <!-- Welcome Section -->
    <div class="p-4 rounded-3 mb-4 text-white"
         style="background-color:#0B3D6E">

        <h1 class="fw-bold">
            Smart Berth Planning System
        </h1>

        <p class="mb-3">
            Manage vessels, berth availability,
            scheduling requests and approvals
            in one place.
        </p>

        <a asp-page="/VesselRegistration"
           class="btn btn-warning me-2 mb-2">
            Register Vessel
        </a>

        <a asp-page="/BerthRequest"
           class="btn btn-light mb-2">
            New Berth Request
        </a>

    </div>

    <!-- Dashboard Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Registered Vessels
                    </h6>

                    <h2 style="color:#0B3D6E" class="counter" data-target="@Model.TotalVessels">
                        @Model.TotalVessels
                    </h2>

                    <a asp-page="/VesselRegistration"
                       class="text-decoration-none">
                        View Vessels
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total Berths
                    </h6>

                    <h2 style="color:#0B3D6E" class="counter" data-target="@Model.TotalBerths">
                        @Model.TotalBerths
                    </h2>

                    <small class="text-success">
                        @Model.AvailableBerths available
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total Requests
                    </h6>

                    <h2 style="color:#0B3D6E" class="counter" data-target="@Model.TotalRequests">
                        @Model.TotalRequests
                    </h2>

                    <a asp-page="/MyRequests"
                       class="text-decoration-none">
                        View Requests
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- Request Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <h6 class="text-muted">
                            Pending Requests
                        </h6>
                        <h2 class="text-warning mb-0 counter" data-target="@Model.PendingRequests">
                            @Model.PendingRequests
                        </h2>
                    </div>

                    <span class="fs-1">⏳</span>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div>
                        <h6 class="text-muted">
                            Approved Requests
                        </h6>
                        <h2 class="text-success mb-0 counter" data-target="@Model.ApprovedRequests">
                            @Model.ApprovedRequests
                        </h2>
                    </div>

                    <span class="fs-1">✅</span>

                </div>
            </div>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 style="color:#0B3D6E">
                Quick Actions
            </h4>

            <div class="d-flex flex-wrap gap-2 mt-3">

                <a asp-page="/VesselRegistration"
                   class="btn btn-outline-primary">
                    Vessel Registration
                </a>

                <a asp-page="/BerthRequest"
                   class="btn btn-outline-primary">
                    Submit Berth Request
                </a>

                <a asp-page="/MyRequests"
                   class="btn btn-outline-primary">
                    My Requests
                </a>

                <a asp-page="/RequestApproval"
                   class="btn btn-outline-primary">
                    Request Approval
                </a>

                <a asp-page="/BerthManagement"
                   class="btn btn-outline-primary">
                    Berth Management
                </a>

            </div>
        </div>
    </div>

    <!-- Recent Requests -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4 class="mb-3" style="color:#0B3D6E">
                Recent Berth Requests
            </h4>

            <div class="table-responsive">
                <table class="table table-striped table-bordered align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Request ID</th>
                            <th>Vessel</th>
                            <th>Berth</th>
                            <th>Arrival</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var request in Model.RecentRequests)
                        {
                            <tr>
                                <td>@request.RequestId</td>

                                <td>
                                    @Model.GetVesselName(request.VesselId)
                                </td>

                                <td>
                                    @Model.GetBerthName(request.BerthId)
                                </td>

                                <td>
                                    @request.ArrivalTime.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    @if (request.Status == RequestStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (request.Status == RequestStatus.Approved)
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            @request.Status
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            @if (!Model.RecentRequests.Any())
            {
                <div class="alert alert-info">
                    No berth requests have been submitted yet.
                </div>
            }

        </div>
    </div>

</div>
