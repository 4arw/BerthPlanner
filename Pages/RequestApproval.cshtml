@page
@model RequestApprovalModel
@using BerthPlanner.Model

@{
    ViewData["Title"] = "Request Approval";
}
@section PageHeader {
    <h2>Request Approval</h2>
    <p>Review berth requests by cargo priority and approve or reject pending submissions.</p>
}
<div class="container mt-4">

    <h2 class="mb-2" style="color:#0B3D6E">
        Request Approval
    </h2>

    <p class="text-muted mb-4">
        Review berth requests by cargo priority
        and approve or reject pending submissions.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success auto-hide">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Pending Requests</h6>
                    <h2 class="text-warning">
                        @Model.PendingCount
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Approved Requests</h6>
                    <h2 class="text-success">
                        @Model.ApprovedCount
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Rejected Requests</h6>
                    <h2 class="text-danger">
                        @Model.RejectedCount
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <div class="alert alert-info">
        <strong>Cargo Priority Rules:</strong>
        Medical and Food = High,
        Fuel = Medium,
        all other cargo = Normal.
        Pending requests are displayed in priority order.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h4 style="color:#0B3D6E">
                Berth Requests
            </h4>

            <div class="table-responsive">

                <table id="approvalTable" class="table table-striped table-bordered align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Vessel</th>
                            <th>Cargo Type</th>
                            <th>Priority</th>
                            <th>Berth</th>
                            <th>Arrival</th>
                            <th>Departure</th>
                            <th>Status</th>
                            <th>Supervisor Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var request in Model.Requests)
                        {
                            <tr>

                                <td>@request.RequestId</td>

                                <td>
                                    @Model.GetVesselName(request.VesselId)
                                </td>

                                <td>
                                    @Model.GetCargoType(request.VesselId)
                                </td>

                                <td  class="priority-cell">
                                    @{
                                        var priority = Model.GetPriorityNumber(request.VesselId);
                                    }

                                    @if (priority == 1)
                                    {
                                        <span class="badge bg-danger">
                                            High
                                        </span>
                                    }
                                    else if (priority == 2)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Medium
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Normal
                                        </span>
                                    }
                                </td>

                                <td>
                                    @Model.GetBerthName(request.BerthId)
                                </td>

                                <td>
                                    @request.ArrivalTime.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    @request.DepartureTime.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    @if (request.Status == RequestStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (request.Status == RequestStatus.Approved)
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            @request.Status
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (request.Status == RequestStatus.Pending)
                                    {
                                        <form method="post">

                                            <input type="hidden"
                                                   name="requestId"
                                                   value="@request.RequestId" />

                                            <textarea name="supervisorNote"
                                                      class="form-control form-control-sm mb-2"
                                                      rows="2"
                                                      maxlength="500"
                                                      placeholder="Supervisor note (optional)"></textarea>

                                            <div class="d-flex gap-2">

                                                <button type="submit" asp-page-handler="Approve"
                                                        class="btn btn-success btn-sm btn-approve">Approve</button>

                                                <button type="submit" asp-page-handler="Reject"
                                                        class="btn btn-danger btn-sm btn-reject">Reject</button>

                                            </div>

                                        </form>
                                    }
                                    else
                                    {
                                        @if (!string.IsNullOrWhiteSpace(request.SupervisorNote))
                                        {
                                            @request.SupervisorNote
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No notes
                                            </span>
                                        }
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.Requests.Any())
            {
                <div class="alert alert-info">
                    No berth requests are available.
                </div>
            }

        </div>
    </div>

</div>
