@page
@model MyRequestsModel
@using BerthPlanner.Model

@{
    ViewData["Title"] = "My Requests";
}
@section PageHeader {
    <h2>My Berth Requests</h2>
    <p>View submitted berth requests and track their approval status.</p>
}
<div class="container mt-4">

    <h2 class="mb-2" style="color:#0B3D6E">
        My Berth Requests
    </h2>

    <p class="text-muted mb-4">
        View submitted berth requests and track
        their approval status.
    </p>

    <!-- Request Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Total Requests</h6>
                    <h2 style="color:#0B3D6E">
                        @Model.TotalRequests
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Pending</h6>
                    <h2 class="text-warning">
                        @Model.PendingRequests
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Approved</h6>
                    <h2 class="text-success">
                        @Model.ApprovedRequests
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h6 class="text-muted">Rejected</h6>
                    <h2 class="text-danger">
                        @Model.RejectedRequests
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Requests Table -->
    <div class="card shadow-sm">
        <div class="card-body">

            <h4 class="mb-3" style="color:#0B3D6E">
                Request History
            </h4>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <input id="searchBox" class="form-control"
                        placeholder="Search by vessel, IMO or berth..." />
                </div>
                <div class="col-md-3">
                    <select id="statusFilter" class="form-select">
                        <option value="">All statuses</option>
                        <option>Pending</option>
                        <option>Approved</option>
                        <option>Rejected</option>
                    </select>
                </div>
                <div class="col-md-3 pt-2 text-muted">
                    Showing <span id="rowCount"></span>
                </div>
            </div>
            <div class="table-responsive">

                <table id="requestsTable" class="table table-striped table-bordered align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Request ID</th>
                            <th>Vessel</th>
                            <th>IMO Number</th>
                            <th>Berth</th>
                            <th>Arrival</th>
                            <th>Departure</th>
                            <th>Request Date</th>
                            <th>Status</th>
                            <th>Supervisor Note</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var request in Model.Requests)
                        {
                            <tr>

                                <td>
                                    @request.RequestId
                                </td>

                                <td>
                                    @Model.GetVesselName(request.VesselId)
                                </td>

                                <td>
                                    @Model.GetVesselIMO(request.VesselId)
                                </td>

                                <td>
                                    @Model.GetBerthName(request.BerthId)
                                </td>

                                <td>
                                    @request.ArrivalTime.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    @request.DepartureTime.ToString("dd MMM yyyy HH:mm")
                                </td>

                                <td>
                                    @request.RequestDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="status-cell">

                                    @if (request.Status == RequestStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (request.Status == RequestStatus.Approved)
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else if (request.Status.ToString() == "Rejected")
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @request.Status
                                        </span>
                                    }

                                </td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(request.SupervisorNote))
                                    {
                                        @request.SupervisorNote
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No notes
                                        </span>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!Model.Requests.Any())
            {
                <div class="alert alert-info mt-3">
                    No berth requests have been submitted yet.
                    Please submit a request first.
                </div>

                <a asp-page="/BerthRequest"
                   class="btn text-white"
                   style="background-color:#0B3D6E">
                    Create New Request
                </a>
            }

        </div>
    </div>

</div>
